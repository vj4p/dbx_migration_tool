{
  "_comment": "Mapping of Informatica PowerCenter built-in functions to PySpark F.* equivalents.",
  "_version": "1.0.0",
  "_catalog": "cder_prod",
  "_secret_scope": "cder-secrets",

  "string_functions": {
    "CONCAT":        { "pyspark": "F.concat(*cols)",                    "notes": "F.concat accepts varargs; use F.concat_ws for separator" },
    "LTRIM":         { "pyspark": "F.ltrim(F.col(c))",                  "notes": "Trims leading whitespace" },
    "RTRIM":         { "pyspark": "F.rtrim(F.col(c))",                  "notes": "Trims trailing whitespace" },
    "LTRIM_RTRIM":   { "pyspark": "F.trim(F.col(c))",                   "notes": "LTRIM+RTRIM combined" },
    "LENGTH":        { "pyspark": "F.length(F.col(c))",                 "notes": "Character length; use F.octet_length for byte length" },
    "SUBSTR":        { "pyspark": "F.substring(F.col(c), pos, len)",    "notes": "1-based; SUBSTR(s,p,l) → F.substring(col,p,l)" },
    "INSTR":         { "pyspark": "F.instr(F.col(c), substr)",          "notes": "Returns 0 if not found (Informatica returns -1); adjust offset" },
    "UPPER":         { "pyspark": "F.upper(F.col(c))",                  "notes": "" },
    "LOWER":         { "pyspark": "F.lower(F.col(c))",                  "notes": "" },
    "INITCAP":       { "pyspark": "F.initcap(F.col(c))",                "notes": "" },
    "REPLACE":       { "pyspark": "F.regexp_replace(F.col(c), pat, rep)","notes": "Informatica REPLACE maps to regexp_replace; escape regex metacharacters" },
    "REPLACECHR":    { "pyspark": "F.regexp_replace(F.col(c), pat, rep)","notes": "Replace character(s); wrap in translate() for single-char maps" },
    "REPLACESTR":    { "pyspark": "F.regexp_replace(F.col(c), pat, rep)","notes": "Replace substring pattern" },
    "RPAD":          { "pyspark": "F.rpad(F.col(c), len, pad)",         "notes": "" },
    "LPAD":          { "pyspark": "F.lpad(F.col(c), len, pad)",         "notes": "" },
    "REVERSE":       { "pyspark": "F.reverse(F.col(c))",                "notes": "" },
    "SOUNDEX":       { "pyspark": "F.soundex(F.col(c))",                "notes": "" },
    "ASCII":         { "pyspark": "F.ascii(F.col(c))",                  "notes": "" },
    "CHR":           { "pyspark": "F.chr(F.col(c))",                    "notes": "" },
    "DECODE":        { "pyspark": "F.when(...).when(...).otherwise(...)", "notes": "Chain F.when() calls; last arg is default → otherwise()" },
    "IIF":           { "pyspark": "F.when(cond, true_val).otherwise(false_val)", "notes": "Direct mapping to F.when().otherwise()" },
    "IS_SPACES":     { "pyspark": "F.trim(F.col(c)) == ''",             "notes": "Returns boolean column" },
    "IS_NULL":       { "pyspark": "F.col(c).isNull()",                  "notes": "" },
    "ISNULL":        { "pyspark": "F.col(c).isNull()",                  "notes": "Alias for IS_NULL" },
    "NVL":           { "pyspark": "F.coalesce(F.col(c), F.lit(default))","notes": "NVL(x, y) → F.coalesce(x, y)" },
    "NVL2":          { "pyspark": "F.when(F.col(c).isNotNull(), v1).otherwise(v2)", "notes": "NVL2(x,a,b): if x not null then a else b" },
    "COALESCE":      { "pyspark": "F.coalesce(*cols)",                  "notes": "" },
    "NULLIF":        { "pyspark": "F.nullif(F.col(a), F.col(b))",       "notes": "" },
    "REG_EXTRACT":   { "pyspark": "F.regexp_extract(F.col(c), pat, grp)","notes": "" },
    "REG_MATCH":     { "pyspark": "F.col(c).rlike(pattern)",            "notes": "Returns boolean column" },
    "REG_REPLACE":   { "pyspark": "F.regexp_replace(F.col(c), pat, rep)","notes": "" },
    "TO_CHAR":       { "pyspark": "F.date_format(F.col(c), fmt) / F.format_number(F.col(c), d)", "notes": "Use date_format for dates; format_number for numbers" },
    "COMPRESS":      { "pyspark": "F.regexp_replace(F.col(c), '\\\\s+', ' ')", "notes": "Collapse multiple spaces to single" },
    "METAPHONE":     { "pyspark": "# No direct equivalent — use phonetic UDF",  "notes": "Implement via phonetic library UDF" },
    "ISDATE":        { "pyspark": "F.to_date(F.col(c), fmt).isNotNull()", "notes": "Cast attempt with isNotNull check" }
  },

  "numeric_functions": {
    "ABS":           { "pyspark": "F.abs(F.col(c))",                   "notes": "" },
    "CEIL":          { "pyspark": "F.ceil(F.col(c))",                  "notes": "" },
    "FLOOR":         { "pyspark": "F.floor(F.col(c))",                 "notes": "" },
    "ROUND":         { "pyspark": "F.round(F.col(c), scale)",          "notes": "" },
    "TRUNC":         { "pyspark": "F.trunc(F.col(c), fmt) / F.bround()", "notes": "For numbers use F.bround or cast; for dates use F.trunc" },
    "MOD":           { "pyspark": "F.col(a) % F.col(b)",              "notes": "Modulo operator" },
    "POWER":         { "pyspark": "F.pow(F.col(c), exp)",             "notes": "" },
    "SQRT":          { "pyspark": "F.sqrt(F.col(c))",                 "notes": "" },
    "EXP":           { "pyspark": "F.exp(F.col(c))",                  "notes": "" },
    "LOG":           { "pyspark": "F.log(base, F.col(c))",            "notes": "F.log(base, col); F.log10 / F.log2 shortcuts available" },
    "LN":            { "pyspark": "F.log(F.col(c))",                  "notes": "Natural log (base e)" },
    "SIN":           { "pyspark": "F.sin(F.col(c))",                  "notes": "" },
    "COS":           { "pyspark": "F.cos(F.col(c))",                  "notes": "" },
    "TAN":           { "pyspark": "F.tan(F.col(c))",                  "notes": "" },
    "ASIN":          { "pyspark": "F.asin(F.col(c))",                 "notes": "" },
    "ACOS":          { "pyspark": "F.acos(F.col(c))",                 "notes": "" },
    "ATAN":          { "pyspark": "F.atan(F.col(c))",                 "notes": "" },
    "ATAN2":         { "pyspark": "F.atan2(F.col(y), F.col(x))",      "notes": "" },
    "COSH":          { "pyspark": "F.cosh(F.col(c))",                 "notes": "" },
    "SINH":          { "pyspark": "F.sinh(F.col(c))",                 "notes": "" },
    "TANH":          { "pyspark": "F.tanh(F.col(c))",                 "notes": "" },
    "SIGN":          { "pyspark": "F.signum(F.col(c))",               "notes": "" },
    "TO_DECIMAL":    { "pyspark": "F.col(c).cast(DecimalType(p, s))",  "notes": "Specify precision and scale" },
    "TO_FLOAT":      { "pyspark": "F.col(c).cast(FloatType())",        "notes": "" },
    "TO_INTEGER":    { "pyspark": "F.col(c).cast(IntegerType())",      "notes": "" },
    "TO_BIGINT":     { "pyspark": "F.col(c).cast(LongType())",         "notes": "" },
    "IN":            { "pyspark": "F.col(c).isin([v1, v2, ...])",      "notes": "IN list predicate" }
  },

  "date_functions": {
    "SYSDATE":       { "pyspark": "F.current_date()",                  "notes": "Current date; use F.current_timestamp() for datetime" },
    "SYSTIMESTAMP":  { "pyspark": "F.current_timestamp()",             "notes": "" },
    "ADD_TO_DATE":   { "pyspark": "F.date_add(F.col(c), n) / F.add_months(F.col(c), n)", "notes": "DD→date_add; MM→add_months; YY→add_months(n*12)" },
    "DATE_DIFF":     { "pyspark": "F.datediff(F.col(d1), F.col(d2))",  "notes": "Returns difference in days; for months use F.months_between" },
    "DATE_COMPARE":  { "pyspark": "F.col(d1) > F.col(d2) / F.col(d1) == F.col(d2)", "notes": "Use standard column comparison operators" },
    "LAST_DAY":      { "pyspark": "F.last_day(F.col(c))",              "notes": "" },
    "NEXT_DAY":      { "pyspark": "F.next_day(F.col(c), dayOfWeek)",   "notes": "" },
    "ROUND_DATE":    { "pyspark": "F.trunc(F.col(c), fmt)",            "notes": "Truncate to month/year; no direct round-to-nearest equivalent" },
    "TRUNC_DATE":    { "pyspark": "F.trunc(F.col(c), fmt)",            "notes": "Truncate date part" },
    "TO_DATE":       { "pyspark": "F.to_date(F.col(c), fmt)",          "notes": "Parse string to date using format string" },
    "TO_DATE_STR":   { "pyspark": "F.date_format(F.col(c), fmt)",      "notes": "Format date as string" },
    "GET_DATE_PART": { "pyspark": "F.year(F.col(c)) / F.month() / F.dayofmonth() / F.hour() / F.minute() / F.second()", "notes": "Use the appropriate date-part extractor" },
    "MAKE_DATE":     { "pyspark": "F.make_date(year, month, day)",     "notes": "" },
    "EXTRACT":       { "pyspark": "F.extract(field, F.col(c))",        "notes": "SQL EXTRACT equivalent; or use F.year/month/etc." },
    "DATE_FORMAT":   { "pyspark": "F.date_format(F.col(c), fmt)",      "notes": "" }
  },

  "aggregate_functions": {
    "SUM":           { "pyspark": "F.sum(F.col(c))",                   "notes": "" },
    "AVG":           { "pyspark": "F.avg(F.col(c))",                   "notes": "" },
    "COUNT":         { "pyspark": "F.count(F.col(c)) / F.count('*')",  "notes": "count(col) excludes NULLs; count('*') counts all rows" },
    "MAX":           { "pyspark": "F.max(F.col(c))",                   "notes": "" },
    "MIN":           { "pyspark": "F.min(F.col(c))",                   "notes": "" },
    "STDDEV":        { "pyspark": "F.stddev(F.col(c))",                "notes": "Sample std dev; use F.stddev_pop for population" },
    "VARIANCE":      { "pyspark": "F.variance(F.col(c))",              "notes": "Sample variance; use F.var_pop for population" },
    "FIRST":         { "pyspark": "F.first(F.col(c), ignorenulls=True)", "notes": "" },
    "LAST":          { "pyspark": "F.last(F.col(c), ignorenulls=True)", "notes": "" },
    "MEDIAN":        { "pyspark": "F.percentile_approx(F.col(c), 0.5)", "notes": "Approximate median" },
    "PERCENTILE":    { "pyspark": "F.percentile_approx(F.col(c), pct)", "notes": "" },
    "COLLECT_LIST":  { "pyspark": "F.collect_list(F.col(c))",           "notes": "Collect values into array (includes duplicates)" },
    "COLLECT_SET":   { "pyspark": "F.collect_set(F.col(c))",            "notes": "Collect distinct values into array" }
  },

  "window_functions": {
    "ROW_NUMBER":    { "pyspark": "F.row_number().over(w)",             "notes": "Requires Window.partitionBy().orderBy()" },
    "RANK":          { "pyspark": "F.rank().over(w)",                   "notes": "Gaps in rank on ties" },
    "DENSE_RANK":    { "pyspark": "F.dense_rank().over(w)",             "notes": "No gaps on ties" },
    "NTILE":         { "pyspark": "F.ntile(n).over(w)",                 "notes": "" },
    "LEAD":          { "pyspark": "F.lead(F.col(c), offset, default).over(w)", "notes": "" },
    "LAG":           { "pyspark": "F.lag(F.col(c), offset, default).over(w)",  "notes": "" },
    "FIRST_VALUE":   { "pyspark": "F.first(F.col(c)).over(w)",          "notes": "" },
    "LAST_VALUE":    { "pyspark": "F.last(F.col(c)).over(w)",           "notes": "Use rowsBetween with unboundedFollowing for correct last value" },
    "SUM_WINDOW":    { "pyspark": "F.sum(F.col(c)).over(w)",            "notes": "Windowed sum; define frame with rowsBetween or rangeBetween" },
    "AVG_WINDOW":    { "pyspark": "F.avg(F.col(c)).over(w)",            "notes": "" },
    "COUNT_WINDOW":  { "pyspark": "F.count(F.col(c)).over(w)",          "notes": "" },
    "CUME_DIST":     { "pyspark": "F.cume_dist().over(w)",              "notes": "" },
    "PERCENT_RANK":  { "pyspark": "F.percent_rank().over(w)",           "notes": "" }
  },

  "type_conversion_functions": {
    "TO_CHAR":       { "pyspark": "F.col(c).cast(StringType())",        "notes": "For numbers; for dates use F.date_format" },
    "TO_DATE":       { "pyspark": "F.to_date(F.col(c), fmt)",           "notes": "" },
    "TO_DECIMAL":    { "pyspark": "F.col(c).cast(DecimalType(p, s))",   "notes": "" },
    "TO_FLOAT":      { "pyspark": "F.col(c).cast(FloatType())",         "notes": "" },
    "TO_INTEGER":    { "pyspark": "F.col(c).cast(IntegerType())",       "notes": "" },
    "CAST":          { "pyspark": "F.col(c).cast(target_type)",         "notes": "Use DataType objects from pyspark.sql.types" }
  },

  "conditional_functions": {
    "IIF":           { "pyspark": "F.when(cond, true_val).otherwise(false_val)", "notes": "" },
    "DECODE":        { "pyspark": "F.when(F.col(c)==v1, r1).when(F.col(c)==v2, r2).otherwise(default)", "notes": "Chain when() calls" },
    "CASE":          { "pyspark": "F.when(...).when(...).otherwise(...)", "notes": "Direct equivalent" },
    "NULLIF":        { "pyspark": "F.nullif(F.col(a), F.col(b))",       "notes": "" },
    "COALESCE":      { "pyspark": "F.coalesce(*cols)",                   "notes": "" }
  },

  "special_functions": {
    "ERROR":         { "pyspark": "# Raise exception or write to quarantine table", "notes": "No direct equivalent — implement error handling in try/except" },
    "ABORT":         { "pyspark": "# raise RuntimeError('...')",         "notes": "Raise exception to halt processing" },
    "SEQGEN_NEXTVAL":{ "pyspark": "F.monotonically_increasing_id()",     "notes": "Non-consecutive unique IDs; use Window.row_number() for consecutive" },
    "LOOKUP":        { "pyspark": "df.join(F.broadcast(df_lookup), on=cond, how='left')", "notes": "Connected lookup → broadcast left join" },
    "STORED_PROC":   { "pyspark": "spark.sql('CALL schema.proc(args)')", "notes": "Re-implement as PySpark transformation where possible" },
    "RAND":          { "pyspark": "F.rand(seed)",                        "notes": "Random double [0.0, 1.0)" },
    "UUID":          { "pyspark": "F.uuid()",                            "notes": "Generates a random UUID string" },
    "HASH":          { "pyspark": "F.hash(*cols) / F.sha2(F.col(c), 256)", "notes": "F.hash is Murmur3; F.sha2 for cryptographic hash" },
    "MD5":           { "pyspark": "F.md5(F.col(c))",                    "notes": "" },
    "CRC32":         { "pyspark": "F.crc32(F.col(c))",                  "notes": "" },
    "BASE64":        { "pyspark": "F.base64(F.col(c))",                 "notes": "" },
    "UNBASE64":      { "pyspark": "F.unbase64(F.col(c))",               "notes": "" }
  },

  "dd_update_strategy_constants": {
    "DD_INSERT":     { "value": 0, "pyspark": "F.lit(0)",               "merge_clause": "whenNotMatchedInsertAll()" },
    "DD_UPDATE":     { "value": 1, "pyspark": "F.lit(1)",               "merge_clause": "whenMatchedUpdateAll()" },
    "DD_DELETE":     { "value": 2, "pyspark": "F.lit(2)",               "merge_clause": "whenMatchedDelete()" },
    "DD_REJECT":     { "value": 3, "pyspark": "F.lit(3)",               "merge_clause": "# Write to quarantine / reject table" }
  },

  "informatica_to_pyspark_datatype_map": {
    "NUMBER":        "DecimalType(precision, scale)",
    "VARCHAR":       "StringType()",
    "VARCHAR2":      "StringType()",
    "CHAR":          "StringType()",
    "NVARCHAR":      "StringType()",
    "NCHAR":         "StringType()",
    "DATE":          "DateType()",
    "TIMESTAMP":     "TimestampType()",
    "DATETIME":      "TimestampType()",
    "INTEGER":       "IntegerType()",
    "BIGINT":        "LongType()",
    "SMALLINT":      "ShortType()",
    "TINYINT":       "ByteType()",
    "FLOAT":         "FloatType()",
    "DOUBLE":        "DoubleType()",
    "DECIMAL":       "DecimalType(precision, scale)",
    "BINARY":        "BinaryType()",
    "BLOB":          "BinaryType()",
    "CLOB":          "StringType()",
    "NCLOB":         "StringType()",
    "BOOLEAN":       "BooleanType()"
  }
}
